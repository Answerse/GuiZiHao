/* ===== 二级页面 Header（Figma 1:1 还原） ===== */

.header.header--secondary {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10000; /* 顶栏最高层级，不被地图/弹窗等元素遮挡 */
  width: 100%;
  height: 80px;
  background-color: #FFFFFF;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  max-width: 100%;
}

.header-secondary-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  gap: 48px;
}

/* ===== Logo 绿底区域（Figma #2120:4768 旗帜：80px 绿色 + 10px 黄绿边，内容垂直居中） ===== */
.header-secondary-logo {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  align-self: flex-start;
  height: 90px;
  padding: 0 24px;
  box-sizing: border-box;
  background-color: var(--color-brand-green-deep);
  border-bottom: 10px solid var(--color-brand-lime);
  flex-shrink: 0;
}

.header-secondary-logo-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 16px 0 0;
}

.header-secondary-logo-mark {
  width: 72px;
  height: 72px;
  flex-shrink: 0;
  display: block;
}

.header-secondary-logo-type {
  width: 124px;
  height: 36px;
  flex-shrink: 0;
  display: block;
}

/* ===== 导航标签区域 ===== */
.header-secondary-tabs {
  display: flex;
  align-self: stretch;
  justify-content: center;
  align-items: stretch;
  gap: 32px;
  flex: 1;
}

.header-secondary-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px 10px;
  gap: 6px;
  border: none;
  background: transparent;
  font-family: 'MiSans', sans-serif;
  font-size: 20px;
  font-weight: 330;
  color: #111827;
  cursor: pointer;
  align-self: stretch;
  transition: all 0.2s ease;
  outline: none;
  white-space: nowrap;
}

.header-secondary-tab--active {
  font-weight: 630;
  font-size: 24px;
  border-bottom: 2px solid #15803D;
  color: #111827;
}

.header-secondary-tab:not(.header-secondary-tab--active):hover {
  color: #15803D;
}

/* ===== 地区选择器 ===== */
.header-secondary-region {
  display: flex;
  align-items: center;
  align-self: stretch;
  gap: 8px;
  width: 200px;
  flex-shrink: 0;
  cursor: pointer;
}

.header-secondary-region-label {
  font-family: 'MiSans', sans-serif;
  font-size: 20px;
  font-weight: 630;
  color: #101215;
  white-space: nowrap;
}

.header-secondary-region-value {
  font-family: 'MiSans', sans-serif;
  font-size: 20px;
  font-weight: 330;
  color: #101215;
  flex: 1;
  white-space: nowrap;
}

.header-secondary-region-arrow {
  width: 14px;
  height: 8px;
  flex-shrink: 0;
}

/* 地区下拉菜单（暂时隐藏，后续可恢复） */
.header-secondary-region-wrapper {
  position: relative;
  display: none;
  align-items: center;
  align-self: stretch;
}

.region-popup--secondary {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  z-index: 1000;
}

.region-popup--secondary .dropdown-popup-inner {
  background-color: #FFFFFF;
  border-radius: 16px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  padding: 24px;
  display: grid;
  grid-template-columns: repeat(4, auto);
  gap: 12px;
  width: max-content;
  max-width: 90vw;
}

/* ===== 搜索按钮（Figma #2222:2696 黄绿底） ===== */
.header-secondary-search {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  width: 80px;
  gap: 10px;
  background-color: var(--color-brand-lime);
  cursor: pointer;
  flex-shrink: 0;
}

.header-secondary-search-icon {
  width: 32px;
  height: 32px;
  display: block;
}

/* ===== 右上角功能区（搜索 + 账号） ===== */
.header-functions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  margin-left: auto;
}

/* ===== 账号按钮（未登录态：登录/注册） ===== */
.header-account-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10px;
  height: 50px;
  padding: 10px 24px;
  box-sizing: border-box;
  background-color: var(--color-brand-green);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 8px;
  cursor: pointer;
  flex-shrink: 0;
  transition: background-color 0.2s ease;
}

.header-account-btn:hover {
  background-color: var(--color-brand-green-deep);
}

.header-account-avatar-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  flex-shrink: 0;
}

.header-account-text {
  font-family: 'MiSans', sans-serif;
  font-size: 16px;
  font-weight: 330;
  color: #FFFFFF;
  line-height: 1.3259999752044678em;
  white-space: nowrap;
}

/* ===== 已登录：首字头像 ===== */
.header-user-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: var(--color-brand-green);
  color: #FFFFFF;
  font-family: 'MiSans', sans-serif;
  font-size: 20px;
  font-weight: 630;
  cursor: pointer;
  user-select: none;
  transition: background-color 0.2s ease;
}

.header-user-avatar:hover {
  background-color: var(--color-brand-green-deep);
}


